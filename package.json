{
  "name": "code-mentor",
  "displayName": "Code Mentor",
  "description": "An AI coding mentor for beginners that teaches instead of generating code.",
  "version": "0.1.0",
  "publisher": "code-mentor-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TODO-YOUR-USERNAME/code-mentor"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "ai",
    "mentor",
    "education",
    "learning",
    "tutor",
    "beginner",
    "web development"
  ],
  "activationEvents": [
    "onView:mentor.chat",
    "onCommand:mentor.openChat",
    "onCommand:mentor.explainSelection",
    "onCommand:mentor.reviewFile",
    "onCommand:mentor.createConfig",
    "onCommand:mentor.testConnection",
    "onCommand:mentor.showLogs",
    "onCommand:mentor.resumeLastSession",
    "onCommand:mentor.showHistory",
    "onCommand:mentor.startQuiz",
    "onCommand:mentor.reviewStructure"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mentor",
          "title": "Code Mentor",
          "icon": "resources/mentor-icon.svg"
        }
      ]
    },
    "views": {
      "mentor": [
        {
          "type": "webview",
          "id": "mentor.chat",
          "name": "Mentor Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "mentor.openChat",
        "title": "Code Mentor: Open Chat"
      },
      {
        "command": "mentor.explainSelection",
        "title": "Mentor: Explain Selection"
      },
      {
        "command": "mentor.reviewFile",
        "title": "Mentor: Review My Code"
      },
      {
        "command": "mentor.createConfig",
        "title": "Mentor: Create Course Config (.mentor.json)"
      },
      {
        "command": "mentor.testConnection",
        "title": "Mentor: Test API Connection"
      },
      {
        "command": "mentor.showLogs",
        "title": "Mentor: Show Logs"
      },
      {
        "command": "mentor.resumeLastSession",
        "title": "Mentor: Resume Last Session"
      },
      {
        "command": "mentor.showHistory",
        "title": "Mentor: Show Chat History"
      },
      {
        "command": "mentor.startQuiz",
        "title": "Mentor: Quiz Me"
      },
      {
        "command": "mentor.reviewStructure",
        "title": "Mentor: Review Project Structure"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mentor.explainSelection",
          "when": "editorHasSelection",
          "group": "mentor"
        }
      ]
    },
    "configuration": {
      "title": "Code Mentor",
      "properties": {
        "mentor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for Code Mentor (e.g. from Google AI Studio)."
        },
        "mentor.model": {
          "type": "string",
          "default": "gemini-3.5-flash-lite",
          "description": "Gemini model to use for mentoring (e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.8-flash)."
        },
        "mentor.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Optional fallback Gemini model if the primary model is not found (e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
