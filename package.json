{
  "name": "polaris",
  "displayName": "Supernova AI",
  "description": "A guiding-star coding mentor with an animated AI cat companion that teaches you to build web interfaces by guiding, questioning, and checking your understanding.",
  "version": "0.1.0",
  "publisher": "code-mentor-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mohith824/polaris"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "supernova",
    "polaris",
    "cat",
    "mascot",
    "learning",
    "mentor",
    "education",
    "ai",
    "tutor",
    "beginner",
    "web development"
  ],
  "activationEvents": [
    "onView:mentor.chat",
    "onCommand:mentor.openChat",
    "onCommand:mentor.explainSelection",
    "onCommand:mentor.reviewFile",
    "onCommand:mentor.createConfig",
    "onCommand:mentor.testConnection",
    "onCommand:mentor.showLogs",
    "onCommand:mentor.resumeLastSession",
    "onCommand:mentor.showHistory",
    "onCommand:mentor.startQuiz",
    "onCommand:mentor.reviewStructure",
    "onCommand:mentor.resetAllData"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mentor",
          "title": "Supernova AI",
          "icon": "resources/mentor-icon.svg"
        }
      ]
    },
    "views": {
      "mentor": [
        {
          "type": "webview",
          "id": "mentor.chat",
          "name": "Supernova AI"
        }
      ]
    },
    "commands": [
      {
        "command": "mentor.openChat",
        "title": "Supernova AI: Open Chat"
      },
      {
        "command": "mentor.explainSelection",
        "title": "Supernova AI: Explain Selection"
      },
      {
        "command": "mentor.reviewFile",
        "title": "Supernova AI: Review My Code"
      },
      {
        "command": "mentor.createConfig",
        "title": "Supernova AI: Create Course Config (.mentor.json)"
      },
      {
        "command": "mentor.testConnection",
        "title": "Supernova AI: Test API Connection"
      },
      {
        "command": "mentor.showLogs",
        "title": "Supernova AI: Show Logs"
      },
      {
        "command": "mentor.resumeLastSession",
        "title": "Supernova AI: Resume Last Session"
      },
      {
        "command": "mentor.showHistory",
        "title": "Supernova AI: Show Chat History"
      },
      {
        "command": "mentor.startQuiz",
        "title": "Supernova AI: Quiz Me"
      },
      {
        "command": "mentor.reviewStructure",
        "title": "Supernova AI: Review Project Structure"
      },
      {
        "command": "mentor.resetAllData",
        "title": "Supernova AI: Reset All Data"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mentor.explainSelection",
          "when": "editorHasSelection",
          "group": "mentor"
        }
      ]
    },
    "configuration": {
      "title": "Supernova AI",
      "properties": {
        "mentor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for Supernova AI (e.g. from Google AI Studio)."
        },
        "mentor.model": {
          "type": "string",
          "default": "gemini-3.5-flash-lite",
          "description": "Gemini model to use for mentoring (e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.8-flash)."
        },
        "mentor.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Optional fallback Gemini model if the primary model is not found (e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
