{
  "name": "code-mentor",
  "displayName": "Code Mentor",
  "description": "An AI coding mentor for beginners that teaches instead of just generating code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Education"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mentor",
          "title": "Code Mentor",
          "icon": "resources/mentor-icon.svg"
        }
      ]
    },
    "views": {
      "mentor": [
        {
          "type": "webview",
          "id": "mentor.chat",
          "name": "Mentor Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "mentor.openChat",
        "title": "Code Mentor: Open Chat"
      },
      {
        "command": "mentor.explainSelection",
        "title": "Mentor: Explain Selection"
      },
      {
        "command": "mentor.reviewFile",
        "title": "Mentor: Review My Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mentor.explainSelection",
          "when": "editorHasSelection",
          "group": "mentor"
        }
      ]
    },
    "configuration": {
      "title": "Code Mentor",
      "properties": {
        "mentor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for Code Mentor (e.g. from Google AI Studio)."
        },
        "mentor.model": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "description": "Gemini model to use for mentoring (e.g. gemini-3.5-flash, gemini-1.5-flash, gemini-2.0-flash)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
